# Runtime: URL com pool pode ser usada. Nunca envie este arquivo com segredos ao cliente.
DATABASE_URL="postgresql://restaurante:restaurante_local@127.0.0.1:55432/restaurante?schema=public"
# Migrations: conexão direta, sem transaction pooler.
DIRECT_URL="postgresql://restaurante:restaurante_local@127.0.0.1:55432/restaurante?schema=public"
APP_URL="http://127.0.0.1:3000"
# Banco dedicado aos testes de integração (também criado por db:local).
TEST_DATABASE_URL="postgresql://restaurante:restaurante_local@127.0.0.1:55432/restaurante_test?schema=public"
# Só habilite o seed de demonstração em banco de desenvolvimento.
ALLOW_DEMO_SEED="true"
